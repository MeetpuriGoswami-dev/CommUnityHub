{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "dev": "pnpm --filter @workspace/api-server --filter @workspace/community-hub --parallel run dev",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@vercel/node": "^5.1.9",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": "^8.4.0",
      "lodash": "^4.18.0"
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js",
      "esbuild",
      "msw",
      "tesseract.js",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@types/express-rate-limit": "^6.0.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0"
  }
}

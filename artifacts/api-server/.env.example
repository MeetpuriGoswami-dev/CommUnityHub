# Copy this file to .env and fill in your actual values
# Never commit the actual .env file

# Database — direct Postgres connection (bypasses RLS, backend only)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Session security — generate a long random string, minimum 32 characters
SESSION_SECRET=replace_with_a_long_random_string_minimum_32_chars

# Bootstrap admin account — use a unique password and keep it private
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_admin_password

# Server
PORT=3000
NODE_ENV=development
